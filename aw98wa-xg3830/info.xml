             d1e365<-d1e608(Restat solvere/primum dubium) d1e380<-d1e643(huic dubio respondet magister)
             d1e395<-d1e667+d1e692(Sed contra magister; 2 folded) d1e410<-d1e712(ista nomina/Boethius 'sedet')
             d1e425<-d1e811(sicut in praec. q.) d1e435<-d1e828(concausa).

           OTHER CLEAN SPLITS: d1e127->d1e127(<-d1e110)+d1e135(<-d1e191 Origen)+d1e150(<-d1e225 Cicero) [editor];
           d1e755->d1e755(<-d1e1142)+d1e768(<-d1e1159); d1e2058->d1e2058(<-d1e2874)+d1e2068(<-d1e2895);
